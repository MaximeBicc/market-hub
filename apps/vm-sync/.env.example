# Phase 1 : shadow uniquement.
VM_SYNC_MODE=shadow

# Worker STAGING uniquement. Ne pas mettre l'URL de production.
CONTROL_PLANE_URL=https://market-hub-staging.example.workers.dev
CONTROL_PLANE_TOKEN=change-me-staging-only

POLL_INTERVAL_MS=60000
LEASE_LIMIT=4
MAX_PAGES_PER_JOB=40
HEALTH_PORT=8080
LOG_LEVEL=info

# Double verrou. "active" restera refusé sans cette phrase exacte.
ALLOW_MARKETPLACE_WRITES=NO
