{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-hub-vm-staging-control",
  "main": "apps/worker/src/vm-staging-entry.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 STRICTEMENT séparée de market-hub-db (production).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-hub-db-staging",
      "database_id": "31a0a44a-e8a3-4995-889f-4b644dffdac3",
      "migrations_dir": "apps/worker/migrations"
    }
  ],

  // Aucun cron, aucune Queue, aucun Durable Object, aucun asset.
  // Ce Worker ne peut donc pas remplacer accidentellement la production.
  "vars": {
    "VM_CONTROL_PLANE_ENABLED": "true",
    "VM_SYNC_ACCOUNT_ALLOWLIST": "vm-stage-mock",
    "VM_ALLOW_CREDENTIAL_PERSIST": "false",
    "VM_LEASE_TTL_SEC": "900"
  },

  "observability": { "enabled": true }
}
